{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verified operational energy incident",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_id", "workshop_code", "onset_time", "source_type", "evidence_ref", "confirmed_by"],
  "properties": {
    "incident_id": {"type": "string", "minLength": 1},
    "workshop_code": {"type": "string", "pattern": "^W[0-9]{2}$"},
    "onset_time": {"type": "string", "format": "date-time"},
    "end_time": {"type": ["string", "null"], "format": "date-time"},
    "source_type": {"enum": ["maintenance_log", "operator_confirmed", "simulation_ground_truth"]},
    "evidence_ref": {"type": "string", "minLength": 1},
    "confirmed_by": {"type": "string", "minLength": 1},
    "notes": {"type": ["string", "null"]}
  }
}
