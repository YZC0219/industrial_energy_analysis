{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/energy-event-v1.json",
  "title": "Industrial energy event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "event_time", "updated_at", "op",
    "record_date", "workshop_code", "energy_code", "consumption",
    "unit", "unit_price", "cost"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_time": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "op": {"enum": ["UPSERT", "DELETE"]},
    "record_date": {"type": "string", "format": "date"},
    "workshop_code": {"type": "string", "pattern": "^W[0-9]{2}$"},
    "energy_code": {"type": "string", "pattern": "^E[0-9]{2}$"},
    "consumption": {"type": ["number", "null"], "minimum": 0},
    "unit": {"type": ["string", "null"]},
    "unit_price": {"type": ["number", "null"], "minimum": 0},
    "cost": {"type": ["number", "null"], "minimum": 0},
    "record_status": {"type": ["string", "null"]},
    "is_production_day": {"type": ["integer", "null"], "enum": [0, 1, null]}
  },
  "allOf": [
    {
      "if": {"properties": {"op": {"const": "UPSERT"}}},
      "then": {
        "properties": {
          "consumption": {"type": "number", "minimum": 0},
          "unit": {"type": "string", "minLength": 1},
          "unit_price": {"type": "number", "exclusiveMinimum": 0},
          "cost": {"type": "number", "minimum": 0}
        }
      }
    }
  ]
}
