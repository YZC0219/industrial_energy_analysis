# 复制成 .env 后按需修改:
#   cp .env.example .env
#
# .env 已在 .gitignore 里, 不会被提交; 这份 .env.example 才是进仓库的模板。

# Airflow 容器内进程的 UID。
#   Linux / macOS: 改成 `id -u` 的输出, 这样容器写出来的文件归你而不归 root
#   Windows (Docker Desktop): 保持 50000 不动, WSL2 后端会处理用户映射
AIRFLOW_UID=50000

# Airflow 用来加密连接口令等敏感字段的密钥。
# 下面这个仅供本地演示 —— 部署到任何真实环境前必须重新生成:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=CW4eOk3E3NBmT-kQ9xZl1akrr2z_opE-5ayR9zZMpQY=

# 项目 MySQL 的 root 口令。该库只跑在容器内部网络里, 不对外暴露。
MYSQL_ROOT_PASSWORD=energy_root_pwd

# Optional Metabase BI profile. Replace before any shared/network deployment.
METABASE_DB_PASSWORD=metabase_local_only
# Set a strong password before running tools/setup_bi_reader.py.
BI_DB_PASSWORD=

# 可选：阶段一 Hive/Spark/DataX 旁路。默认关闭，不影响原 MySQL 管道。
LAKEHOUSE_ENABLED=0
MYSQL_JDBC_URL=jdbc:mysql://mysql:3306/industrial_energy
HDFS_DEFAULT_FS=hdfs://namenode:8020
HIVE_STAGE_PATH=/warehouse/energy_ods
DATAX_ENTRY=/opt/datax/bin/datax.py
SPARK_SQL=spark-sql
ENERGY_ALERT_WEBHOOK=

# 可选：只有 Kafka topic 含与本批次相同范围的完整 CDC 历史时才启用。
# 当前 energy-events 是单机演示 topic，不能与全量 clean_batch_energy.csv 对账。
STREAM_RECON_ENABLED=0
STREAM_RECON_BATCH_TIMEZONE=Asia/Shanghai
STREAM_RECON_BOOTSTRAP=kafka:9092
STREAM_RECON_TOPIC=energy-events

# 可选：OpenAI Chat Completions 兼容模型服务，仅在 --use-llm 时读取。
# URL 应指向完整的 /v1/chat/completions 端点；本地无鉴权服务可将 API key 留空。
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=90
